<Window x:Class="HddDefrag.UI.AnalysisDoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyse abgeschlossen" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource Win98Window}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Info-Symbol im Stil der alten Meldungsfenster -->
    <Grid Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0">
      <Ellipse Fill="#0000FF" Stroke="#000080" StrokeThickness="1" />
      <TextBlock Text="i" Foreground="#FFFFFF" FontWeight="Bold" FontFamily="Times New Roman" FontSize="22"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Column="1">
      <TextBlock x:Name="DriveText" FontWeight="Bold" />
      <TextBlock x:Name="SummaryText" Margin="0,6,0,0" TextWrapping="Wrap" />
      <TextBlock x:Name="AdviceText" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="DefragButton" Content="Defragmentieren" MinWidth="110" Margin="0,0,8,0" Click="DefragButton_Click" />
      <Button x:Name="CloseButton" Content="Schließen" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
